rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contracts/{contractId} {
      allow read, write: if request.auth != null;
    }
    // Cấu hình tự động hóa (bật/tắt nhắc, email nhận, số ngày nhắc)
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
